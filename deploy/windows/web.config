<?xml version="1.0" encoding="UTF-8"?>
<!--
  Put this file in an "agent" folder at the root of the HTTPS site, so /agent/* proxies to the agent.
  Requires the IIS URL Rewrite and Application Request Routing (ARR) modules, with the ARR proxy enabled:
    & "$env:windir\system32\inetsrv\appcmd.exe" set config -section:system.webServer/proxy /enabled:"True" /commit:apphost
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="status-agent" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8765/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
